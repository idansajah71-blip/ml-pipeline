# ML Pipeline Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# CRITICAL: Production Security Settings
# =============================================================================

# REQUIRED in production: Set a secure random string (e.g., from: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=

# Set to 'production' for live deployment, 'development' for local work
ENVIRONMENT=development

# Set to False in production
DEBUG=False

# =============================================================================
# Database Configuration
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ml_pipeline_db
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=ml_password

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Application Settings
# =============================================================================

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# ML Pipeline Settings
# =============================================================================

ML_ARTIFACTS_DIR=./ml_artifacts
MAX_UPLOAD_SIZE_MB=100
TRAINING_TIMEOUT_SECONDS=300
SHAP_MAX_SAMPLES=100

# =============================================================================
# Celery Configuration (Optional - uses Redis if not set)
# =============================================================================

# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Monitoring & Logging
# =============================================================================

ENABLE_METRICS=True
LOG_LEVEL=INFO
